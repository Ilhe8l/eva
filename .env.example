# Configurações da Eva
# Copie este arquivo para .env e preencha

# 1. Escolha de Modelo (Descomente o que quiser usar)
# EVA_MODEL=gemini-2.5-flash
# EVA_MODEL=eva-voice

# 2. Chave do Gemini (se EVA_MODEL for gemini)
GEMINI_API_KEY=sua_chave_aqui

# 3. LM Studio (se usar local via EVA_MODEL local)
EVA_LM_STUDIO_URL=http://localhost:1234/v1
