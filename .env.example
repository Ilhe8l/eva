# Copy to .env and fill in.

# Chat model as provider:model.
# Local model served by LM Studio (use the id shown in LM Studio):
EVA_MODEL=lmstudio:qwen3-8b
# EVA_LM_STUDIO_URL=http://localhost:1234/v1
# Or a cloud model, e.g. Gemini (reads GEMINI_API_KEY or GOOGLE_API_KEY):
# EVA_MODEL=google_genai:gemini-3.8-flash
# GEMINI_API_KEY=

# Local speech (optional).
# EVA_WHISPER_MODEL=large-v3-turbo
# EVA_VOICE=af_heart
# EVA_VOICE_LANGUAGE=a

# Let Eva run commands and edit files without asking (toggle live with :auto on|off).
# EVA_AUTONOMOUS=1

# Minutes of silence before Eva checks in on her own (0 disables).
# EVA_HEARTBEAT_MINUTES=30

# Optional Hugging Face token: faster model downloads, no rate-limit warning.
# HF_TOKEN=
# If model downloads stall at the same size, fall back to plain HTTP:
# HF_HUB_DISABLE_XET=1

# Container user (docker compose only): output of `id -u` and `id -g`.
# EVA_UID=1000
# EVA_GID=1000
