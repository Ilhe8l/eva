# Copy to .env and fill in.

# Chat model as provider:model.
# Gemini (reads GEMINI_API_KEY or GOOGLE_API_KEY):
EVA_MODEL=google_genai:gemini-2.5-flash
GEMINI_API_KEY=
# Local model served by LM Studio:
# EVA_MODEL=lmstudio:qwen3-8b
# EVA_LM_STUDIO_URL=http://localhost:1234/v1

# Local speech (optional).
# EVA_WHISPER_MODEL=small
# EVA_VOICE=af_heart
# EVA_VOICE_LANGUAGE=a

# Container user (docker compose only): output of `id -u` and `id -g`.
# EVA_UID=1000
# EVA_GID=1000
